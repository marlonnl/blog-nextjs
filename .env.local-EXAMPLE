# simula a demora de consultas no DB
SIMULATE_LOADING_TIME=0

# tamanho máximo de upload de arquivo
# padrão 900kb (921600)
NEXT_PUBLIC_IMAGE_UPLOAD_MAX_SIZE=921600

# pasta de upload de imagens
IMAGE_UPLOAD_DIR="uploads"

# Url completa do servidor de imagens (sem / final)
IMAGE_SERVER_URL="http://localhost:3001/uploads"

# Chave de assinatura chave jwt
# Usar o comando 'npx tsx src/utils/generate-hashed-pwd.ts' para gerar uma chave
JWT_SECRET_KEY="leia o comentário acima"

# Tempo de expiração do login (usar o mesmo valor em segundos e string)
# exemplo: 3600 -> 1h, 600 -> 10m, 86400 -> 1d
LOGIN_EXPIRATION_SECONDS=86400
LOGIN_EXPIRATION_STRING="1d"

# Nome do cookie login
LOGIN_COOKIE_NAME="loginSession"

# Nome de usuário /admin/login
LOGIN_USER="SEU_USUARIO"

# Usar o comando 'npx tsx src/utils/generate-hashed-pwd.ts' para gerar o hash da senha
LOGIN_PASS="leia o comentário acima"

# 0 nao; 1 sim
ALLOW_LOGIN=1
